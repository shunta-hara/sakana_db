{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "api/*": ["./src/api/*"],
      "entities/*": ["./src/entities/*"],
      "repositories/*": ["./src/repositories/*"]
    },
    "incremental": true
  },
  "exclude": ["node_modules", "dist"]
}
